@{
    ViewData["Title"] = "GoatFarm — Goat Farm Management";
}

<h2>Goat Farm Management Solution</h2>
<p>Sign in to manage your herd.</p>

@if (User.Identity?.IsAuthenticated == true)
{
    <a href="/Home/Dashboard">Go to dashboard</a>
}
else
{
    <a href="/Account/Login">Log in</a>
    <p><a href="@ViewBag.ForgotPasswordUrl">Forgot password?</a></p>
}
